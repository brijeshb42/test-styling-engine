{
  "name": "@brijbyte/styled-cache",
  "version": "0.0.1",
  "description": "A cache for styled components",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "scripts": {
    "build": "tsup"
  },
  "keywords": [
    "react",
    "emotion",
    "server-components",
    "styled-components",
    "css-in-js"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": "*"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": "^15.1.7",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": {
        "import": "./dist/index.server.mjs",
        "require": "./dist/index.server.js",
        "default": "./dist/index.server.mjs"
      },
      "default": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js",
        "default": "./dist/index.mjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "CHANGELOG.md",
    "README.md"
  ]
}
