{
  "name": "@brijbyte/styled-preprocessor-stylis",
  "version": "0.0.1",
  "description": "A preprocessor for Stylis used by @brijbyte/styled",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts"
  },
  "dependencies": {
    "stylis": "^4.3.6"
  },
  "devDependencies": {
    "@types/stylis": "^4.2.7"
  },
  "keywords": [
    "stylis",
    "preprocessor",
    "css-in-js",
    "styled-components"
  ],
  "author": "",
  "license": "MIT",
  "imports": {
    "#is-development": {
      "development": "./src/conditions/true.ts",
      "default": "./src/conditions/false.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    }
  }
}
