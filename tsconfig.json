{
  "compilerOptions": {
    "module": "esnext",
    // aligning with Node18 recommendation: https://www.npmjs.com/package/@tsconfig/node18
    "target": "es2022",
    "lib": ["es2020", "dom", "ES2021.String", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "baseUrl": "./",
    "allowSyntheticDefaultImports": true,
    "noErrorTruncation": false,
    "allowJs": true,
    "paths": {
      "@joy/styling-engine-context": ["./packages/context/src"],
      "@joy/styling-engine-context/*": ["./packages/context/src/*"],
      "@joy/styling-engine": ["./packages/engine/src"],
      "@joy/styling-engine/*": ["./packages/engine/src/*"],
      "@joy/styling-engine-babel-plugin": [
        "./packages/engine-babel-plugin/src"
      ],
      "@joy/joy-ui": ["./packages/joy/src"],
      "@joy/joy-ui/*": ["./packages/joy/src/*"],
      "@brijbyte/styled": ["./packages/styled/src"],
      "@brijbyte/styled/*": ["./packages/styled/src/*"],
      "@brijbyte/styled-cache": ["./packages/styled-cache/src"],
      "@brijbyte/styled-cache/*": ["./packages/styled-cache/src/*"],
      "@brijbyte/styled-preprocessor-stylis": ["./packages/styled-preprocessor-stylis/src"],
      "@brijbyte/styled-preprocessor-stylis/*": ["./packages/styled-preprocessor-stylis/src/*"]
    },
    // Otherwise we get react-native typings which conflict with dom.lib.
    "types": ["node", "react", "vitest/globals"]
  },
  "exclude": ["**/.*/", "**/build", "**/node_modules", "docs/export"]
}
